NODE_ENV=development
PORT=4000
# Set a long random secret in the hosting environment; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
# Add the Neon pooled connection string in your host's secret/environment settings.
# Never commit a real DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Exact origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
