{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokora",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "main": "worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "SOKORA_DB",
      "database_name": "sokora-main-db",
      "database_id": "9c39726a-e0cd-4b7f-884c-86cd6954b9cd"
    }
  ],
  "hyperdrive": [
    {
      "binding": "sokora_hyperdrive",
      "id": "c2538b4fe4a846bfb597e8f7d0c4edf2"
    }
  ],
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "dbf6707e8039445788efcf7bef29d643"
      },
      {
        "binding": "sokora_db",
        "id": "dbf6707e8039445788efcf7bef29d643"
      },
      {
        "binding": "sokora_hyperdrive",
        "id": "c2538b4fe4a846bfb597e8f7d0c4edf2"
      }
    ]
  }
}
