{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokora",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "main": "worker/index.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dbf6707e8039445788efcf7bef29d643"
    }
  ]
}
