{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokora",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "main": "worker/index.js",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
